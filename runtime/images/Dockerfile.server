FROM ubuntu:22.04
COPY bin/ /opt/runtime/bin/
COPY lib/ /opt/runtime/lib/
COPY modules/ /opt/runtime/modules/
ENV LD_LIBRARY_PATH=/opt/runtime/lib
ENV MLU_REMOTE_MODULE_DIR=/opt/runtime/modules
ENV COREX_REMOTE_BIND=0.0.0.0 MLU_REMOTE_BIND=0.0.0.0
ENV COREX_REMOTE_PORT=50051 MLU_REMOTE_PORT=50051
ENV COREX_REMOTE_OBSERVATION_PORT=50052 MLU_REMOTE_OBSERVATION_PORT=50052
EXPOSE 50051 50052
ENTRYPOINT ["/opt/runtime/bin/server"]
